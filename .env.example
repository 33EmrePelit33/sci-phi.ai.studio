# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Primary domain configuration
PRIMARY_DOMAIN="sci-phi.ai.studio"

# Umami Analytics Configuration (Umami Cloud)
UMAMI_WEBSITE_ID="your-sci-phi-umami-website-id"
UMAMI_API_KEY="your-umami-api-key"
UMAMI_HOST_URL="https://cloud.umami.is"
UMAMI_LEGACY_SCIPHIL_WEBSITE_ID="legacy-sciphil-website-id"
UMAMI_BLOGGER_WEBSITE_ID="blogger-website-id"
UMAMI_GROKME_WEBSITE_ID="grokme-website-id"
ANALYTICS_START_AT="2026-10-12T00:00:00+03:00"
